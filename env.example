# Milan Hydrotech — environment variables. Copy to .env for local work; on the host, set them in its
# Environment page. NEVER commit real values.

DJANGO_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=False            # True only on your own computer
ALLOWED_HOSTS=milanhydrotech.co.tz,www.milanhydrotech.co.tz
SITE_URL=https://milanhydrotech.co.tz
ADMIN_URL=admin/              # change to something hard to guess, e.g. usimamizi-8k2p/

# Supabase -> Connect -> Session pooler (Postgres)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Storage: create a PUBLIC bucket, then Storage -> Settings -> S3 access keys
SUPABASE_PROJECT_REF=         # the <ref> in https://<ref>.supabase.co
SUPABASE_BUCKET=milan-hydrotech
SUPABASE_S3_REGION=eu-central-1   # the region shown next to the S3 endpoint
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Optional: email the office when someone sends the contact form
# INQUIRY_NOTIFY_EMAIL=msgodfrey559@gmail.com
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
